# Tatum Sui RPC key. Server-side ONLY — read by the Vite dev-server proxy
# (see vite.config.ts). Never prefix with VITE_ — that would expose it to the
# browser bundle. In production, this lives in a serverless function instead.
TATUM_API_KEY=

# Browser-safe flag. When "true", the client posts to /rpc/sui-testnet (proxied);
# otherwise it falls back to the public Sui testnet RPC.
VITE_USE_TATUM=

# Published Move package ID. See contracts/mnemo/deployments/testnet.json.
VITE_MNEMO_PACKAGE_ID=

# Walrus endpoints — testnet publisher (PUT) and aggregator (GET).
VITE_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
VITE_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
